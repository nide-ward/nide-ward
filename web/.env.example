# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings > Environment Variables.

# --- Database: Neon Postgres ---------------------------------------------------------
# Neon console > Connect > pooled connection string (ends with ?sslmode=require).
DATABASE_URL=

# --- Authentication: self-hosted Better Auth ----------------------------------------------
# At least 32 random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public origin of the app. http://localhost:3000 locally, https://your-domain on Vercel.
BETTER_AUTH_URL=http://localhost:3000
# Idle session lifetime in minutes (sliding). Short on purpose for shared ward computers. 15 to 1440.
SESSION_MAX_AGE_MINUTES=120

# --- Lab photo storage: any S3-compatible bucket (keep the bucket PRIVATE) ---------------
# The AWS SDK reads the four AWS_* variables by itself.
#
# Default: Neon Object Storage
#   AWS_ENDPOINT_URL_S3 looks like https://<branch>.storage.<cell>.<region>.aws.neon.tech
#   AWS_REGION is the Neon region, for example eu-central-1
#   Create the access key pair in the Neon console. Neon needs path-style addressing.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#
# Alternative: Cloudflare R2
#   AWS_ENDPOINT_URL_S3=https://<account_id>.r2.cloudflarestorage.com
#   AWS_REGION=auto
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY = an R2 API token (Object Read & Write, scoped to the bucket)
#
S3_BUCKET=
# Neon requires path-style addressing; R2 works with it too. Leave "true" unless your provider needs virtual-hosted style.
S3_FORCE_PATH_STYLE=true
# presigned = the browser PUTs the photo straight to the bucket (needs CORS on the bucket).
# proxy     = the browser POSTs the photo to this app, which stores it (no bucket CORS needed, 4 MB limit, goes through Vercel).
S3_UPLOAD_MODE=presigned

# --- First attending (used only by `bun run admin:create`) ----------------------------------
# Remove SEED_ADMIN_PASSWORD from your environment after the account exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_BADGE=
